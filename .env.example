# Vorlage: kopieren als .env (im Repo-Root, ist gitignored) und ausfüllen.
#   cp .env.example .env
#
# Wichtig: Werte hier sind BEISPIELE — echte Werte nur in der .env, nie committen.

# IP des Waypoint in Seite A. Empfehlung: im Router (z. B. FritzBox) eine
# feste IP für den Waypoint reservieren, sonst ändert DHCP sie irgendwann
# und die Client-Profile stimmen nicht mehr.
ENDPOINT_HOST=192.168.178.28

# Selbst gewähltes Admin-Passwort für die Control-Plane-API (Header X-Admin-Token).
ADMIN_TOKEN=hier-ein-eigenes-token-waehlen
